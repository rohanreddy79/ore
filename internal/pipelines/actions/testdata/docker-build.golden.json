{
  "version": "0",
  "id": ".github/workflows/docker-build.yml",
  "repository": {
    "id": "repo_CORPUS",
    "org_id": "org_CORPUS"
  },
  "trigger": {
    "event": "io.ore.ref.updated",
    "filters": {
      "cel": "(event.type == 'io.ore.ref.updated' \u0026\u0026 (matches(event.ref_name, '^main$')) \u0026\u0026 (matches(event.ref_name, '^v[^/]*\\.[^/]*\\.[^/]*$')) \u0026\u0026 startsWith(event.ref, 'refs/tags/')) || (event.type == 'io.ore.change.patchset.pushed')"
    },
    "events": [
      {
        "name": "push",
        "branches": [
          "main"
        ],
        "tags": [
          "v*.*.*"
        ]
      },
      {
        "name": "pull_request"
      }
    ]
  },
  "policy_context": {
    "ref_trust": "internal"
  },
  "tasks": [
    {
      "id": "docker-build/image",
      "name": "image",
      "inputs": {
        "source": {
          "commit": "9fceb02d0ae598e95dc970b74767f19372d61af8",
          "submodules": "none"
        },
        "image": {
          "ref": "ghcr.io/catthehacker/ubuntu:act-latest"
        },
        "actions": [
          {
            "ref": "actions/checkout@v4",
            "repository": "actions/checkout",
            "sha": "11bd71901bbe5b1630ceea73d27597364c9af683",
            "resolution": "tag-mutable-resolved"
          },
          {
            "ref": "docker/build-push-action@v6",
            "repository": "docker/build-push-action",
            "sha": "4f58ea79222b3b9dc2c8bbdd6debcef730109a75",
            "resolution": "tag-mutable-resolved"
          },
          {
            "ref": "docker/login-action@v3",
            "repository": "docker/login-action",
            "sha": "9780b0c442fbb1117ed29e0efdff1e18412f7567",
            "resolution": "tag-mutable-resolved"
          },
          {
            "ref": "docker/setup-buildx-action@v3",
            "repository": "docker/setup-buildx-action",
            "sha": "c47758b77c9736f4b2ef4073d4d51994fabfe501",
            "resolution": "tag-mutable-resolved"
          }
        ],
        "params": {
          "env": {
            "IMAGE": "ghcr.io/${{ github.repository }}"
          },
          "fail_fast": true,
          "job": "image",
          "strategy": {
            "fail-fast": true,
            "job-index": 0,
            "job-total": 1,
            "max-parallel": 1
          },
          "workflow": "docker-build",
          "workflow_name": "Docker"
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "uses": "docker/setup-buildx-action@v3"
        },
        {
          "uses": "docker/login-action@v3",
          "with": {
            "password": "${{ secrets.GITHUB_TOKEN }}",
            "registry": "ghcr.io",
            "username": "${{ github.actor }}"
          },
          "condition": "github.event_name != 'pull_request'"
        },
        {
          "uses": "docker/build-push-action@v6",
          "with": {
            "cache-from": "type=gha",
            "cache-to": "type=gha,mode=max",
            "context": ".",
            "push": "${{ github.event_name != 'pull_request' }}",
            "tags": "${{ env.IMAGE }}:${{ github.sha }}"
          }
        },
        {
          "name": "Fallback build",
          "run": "docker build -t \"$IMAGE:$GITHUB_SHA\" ."
        }
      ],
      "executor": {
        "kind": "docker",
        "os": "linux",
        "arch": "x64",
        "labels": [
          "ubuntu-latest"
        ]
      },
      "outputs": {
        "summary": true
      },
      "limits": {
        "timeout_seconds": 21600
      },
      "permissions": {
        "contents": "read",
        "packages": "write"
      },
      "content_hash": "sha256:f55e37b5f9c61e0135c2514ca067978d775d156986dedbbdc38b2b90c52f6fc4"
    }
  ],
  "source": {
    "frontend": "actions-yaml",
    "path": ".github/workflows/docker-build.yml",
    "compiler_version": "0.1.0",
    "divergences": [
      {
        "code": "uses.unsupported-action",
        "message": "docker/setup-buildx-action@v3 is not implemented natively on Ore v0; the step is skipped at run time and recorded here",
        "location": "jobs.image.steps[1]"
      },
      {
        "code": "secrets.github-token",
        "message": "secrets.GITHUB_TOKEN has no equivalent on Ore v0; an empty value is injected",
        "location": "jobs.image.steps[2].with.password"
      },
      {
        "code": "uses.unsupported-action",
        "message": "docker/login-action@v3 is not implemented natively on Ore v0; the step is skipped at run time and recorded here",
        "location": "jobs.image.steps[2]"
      },
      {
        "code": "uses.unsupported-action",
        "message": "docker/build-push-action@v6 is not implemented natively on Ore v0; the step is skipped at run time and recorded here",
        "location": "jobs.image.steps[3]"
      }
    ]
  }
}
