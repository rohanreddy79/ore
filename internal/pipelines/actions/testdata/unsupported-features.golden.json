            "ref": "actions/github-script@v7",
            "repository": "actions/github-script",
            "sha": "60a0d83039c74a4aee543508d2ffcb1c3799cdea",
            "resolution": "tag-mutable-resolved"
          }
        ],
        "params": {
          "env": {},
          "fail_fast": true,
          "job": "with-services",
          "strategy": {
            "fail-fast": true,
            "job-index": 0,
            "job-total": 1,
            "max-parallel": 1
          },
          "workflow": "unsupported-features",
          "workflow_name": "Kitchen sink"
        },
        "secrets": [
          {
            "path": "repos/acme/app/secrets/PGPASSWORD",
            "mount": "env",
            "name": "PGPASSWORD"
          }
        ],
        "services": [
          {
            "name": "postgres",
            "image": "postgres:16",
            "env": {
              "POSTGRES_PASSWORD": "postgres"
            },
            "ports": [
              "5432:5432"
            ]
          }
        ]
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "path": "other",
            "ref": "develop",
            "repository": "acme/other",
            "submodules": "recursive"
          }
        },
        {
          "uses": "actions/github-script@v7",
          "with": {
            "script": "github.rest.issues.createComment({ body: 'hi' })\n"
          }
        },
        {
          "uses": "docker://alpine:3.19",
          "with": {
            "args": "echo hello"
          }
        },
        {
          "uses": "./.github/actions/setup"
        },
        {
          "run": "psql -h postgres -c 'select 1'",
          "shell": "bash",
          "working_directory": "app",
          "env": {
            "ALL": "${{ toJSON(secrets) }}",
            "PGPASSWORD": "${{ secrets.PGPASSWORD }}",
            "VAR": "${{ vars.REGION }}"
          }
        }
      ],
      "executor": {
        "kind": "docker",
        "os": "linux",
        "arch": "x64",
