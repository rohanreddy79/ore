    {
      "id": "unsupported-features/with-services",
      "name": "with-services",
      "inputs": {
        "source": {
          "commit": "9fceb02d0ae598e95dc970b74767f19372d61af8",
          "submodules": "none"
        },
        "image": {
          "ref": "golang:1.25"
        },
