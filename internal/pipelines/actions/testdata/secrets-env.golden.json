{
  "version": "0",
  "id": ".github/workflows/secrets-env.yml",
  "repository": {
    "id": "repo_CORPUS",
    "org_id": "org_CORPUS"
  },
  "trigger": {
    "event": "io.ore.ref.updated",
    "filters": {
      "cel": "(event.type == 'io.ore.ref.updated' \u0026\u0026 (matches(event.ref_name, '^main$')))"
    },
    "events": [
      {
        "name": "push",
        "branches": [
          "main"
        ]
      }
    ]
  },
  "policy_context": {
    "ref_trust": "internal"
  },
  "tasks": [
    {
      "id": "secrets-env/publish",
      "name": "publish",
      "inputs": {
        "source": {
          "commit": "9fceb02d0ae598e95dc970b74767f19372d61af8",
          "submodules": "none"
        },
        "image": {
          "ref": "ghcr.io/catthehacker/ubuntu:act-latest"
        },
        "actions": [
          {
            "ref": "actions/checkout@v4",
            "repository": "actions/checkout",
            "sha": "11bd71901bbe5b1630ceea73d27597364c9af683",
            "resolution": "tag-mutable-resolved"
          },
          {
            "ref": "actions/setup-node@v4",
            "repository": "actions/setup-node",
            "sha": "39370e3970a6d050fe5d0e2d3f6f5f4d9c8e3b3c",
            "resolution": "tag-mutable-resolved"
          },
          {
            "ref": "docker/login-action@v3",
            "repository": "docker/login-action",
            "sha": "9780b0c442fbb1117ed29e0efdff1e18412f7567",
            "resolution": "tag-mutable-resolved"
          }
        ],
        "params": {
          "env": {
            "NPM_TOKEN": "${{ secrets.NPM_TOKEN }}",
            "REGISTRY": "ghcr.io"
          },
          "environment": "production",
          "environment_url": "",
          "fail_fast": true,
          "job": "publish",
          "strategy": {
            "fail-fast": true,
            "job-index": 0,
            "job-total": 1,
            "max-parallel": 1
          },
          "workflow": "secrets-env",
          "workflow_name": "Secrets"
        },
        "secrets": [
          {
            "path": "repos/acme/app/secrets/NPM_TOKEN",
            "mount": "env",
            "name": "NPM_TOKEN"
          },
          {
            "path": "repos/acme/app/secrets/SLACK_TOKEN",
            "mount": "env",
            "name": "SLACK_TOKEN"
          }
        ]
      },
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": "20",
            "registry-url": "https://registry.npmjs.org"
          }
        },
        {
          "run": "npm publish --access public",
          "env": {
            "NODE_AUTH_TOKEN": "${{ secrets.NPM_TOKEN }}"
          }
        },
        {
          "uses": "docker/login-action@v3",
          "with": {
            "password": "${{ secrets.GITHUB_TOKEN }}",
            "registry": "${{ env.REGISTRY }}",
            "username": "${{ github.actor }}"
          }
        },
        {
          "run": "curl -H \"Authorization: Bearer ${{ secrets.SLACK_TOKEN }}\" https://slack.example/notify\n"
        }
      ],
      "executor": {
        "kind": "docker",
        "os": "linux",
        "arch": "x64",
        "labels": [
          "ubuntu-latest"
        ]
      },
      "outputs": {
        "summary": true
      },
      "limits": {
        "timeout_seconds": 21600
      },
      "permissions": {
        "contents": "read",
        "id-token": "write",
        "packages": "write"
      },
      "content_hash": "sha256:06d30fbc6985767840a8adbeeefc75a21f24fa5c42928b3d69e6d65ee91081c5"
    },
    {
      "id": "secrets-env/staging",
      "name": "staging",
      "inputs": {
        "source": {
          "commit": "9fceb02d0ae598e95dc970b74767f19372d61af8",
          "submodules": "none"
        },
        "image": {
          "ref": "ghcr.io/catthehacker/ubuntu:act-latest"
        },
        "params": {
          "env": {
            "REGISTRY": "ghcr.io"
          },
          "environment": "staging",
          "environment_url": "",
          "fail_fast": true,
          "job": "staging",
          "strategy": {
            "fail-fast": true,
            "job-index": 0,
            "job-total": 1,
            "max-parallel": 1
          },
          "workflow": "secrets-env",
          "workflow_name": "Secrets"
        },
        "secrets": [
          {
            "path": "repos/acme/app/secrets/API_KEY",
            "mount": "env",
            "name": "API_KEY"
          }
        ]
      },
      "steps": [
        {
          "run": "./smoke.sh",
          "env": {
            "API_KEY": "${{ secrets.API_KEY }}"
          }
        }
      ],
      "executor": {
        "kind": "docker",
        "os": "linux",
        "arch": "x64",
        "labels": [
          "ubuntu-latest"
        ]
      },
      "outputs": {
        "summary": true
      },
      "limits": {
        "timeout_seconds": 21600
      },
      "content_hash": "sha256:03f9f4f357c72e64cf63a742f836ec874726a2e2e0d3eaeab5e74abdebed5c60"
    }
  ],
  "source": {
    "frontend": "actions-yaml",
    "path": ".github/workflows/secrets-env.yml",
    "compiler_version": "0.1.0",
    "divergences": [
      {
        "code": "secrets.github-token",
        "message": "secrets.GITHUB_TOKEN has no equivalent on Ore v0; an empty value is injected",
        "location": "jobs.publish.steps[3].with.password"
      },
      {
        "code": "uses.unsupported-action",
        "message": "docker/login-action@v3 is not implemented natively on Ore v0; the step is skipped at run time and recorded here",
        "location": "jobs.publish.steps[3]"
      }
    ]
  }
}
