{
  "version": "0",
  "id": ".github/workflows/workflow-dispatch-inputs.yml",
  "repository": {
    "id": "repo_CORPUS",
    "org_id": "org_CORPUS"
  },
  "trigger": {
    "event": "io.ore.pipeline.dispatch",
    "filters": {
      "cel": "(event.type == 'io.ore.pipeline.dispatch' \u0026\u0026 event.pipeline == '.github/workflows/workflow-dispatch-inputs.yml')"
    },
    "inputs": {
      "dry-run": {
        "type": "boolean",
        "default": true
      },
      "environment": {
        "type": "choice",
        "default": "staging",
        "options": [
          "staging",
          "production"
        ],
        "required": true
      },
      "replicas": {
        "type": "number",
        "default": 2
      },
      "version": {
        "type": "string"
      }
    },
    "events": [
      {
        "name": "workflow_dispatch"
      }
    ]
  },
  "policy_context": {
    "ref_trust": "internal"
  },
  "tasks": [
    {
      "id": "workflow-dispatch-inputs/deploy",
      "name": "deploy",
      "inputs": {
        "source": {
          "commit": "9fceb02d0ae598e95dc970b74767f19372d61af8",
          "submodules": "none"
        },
        "image": {
          "ref": "ghcr.io/catthehacker/ubuntu:act-latest"
        },
        "params": {
          "env": {},
          "environment": "",
          "fail_fast": true,
          "job": "deploy",
          "strategy": {
            "fail-fast": true,
            "job-index": 0,
            "job-total": 1,
            "max-parallel": 1
          },
          "workflow": "workflow-dispatch-inputs",
          "workflow_name": "Deploy"
        },
        "secrets": [
          {
            "path": "repos/acme/app/secrets/DEPLOY_TOKEN",
            "mount": "env",
            "name": "DEPLOY_TOKEN"
          }
        ]
      },
      "steps": [
        {
          "run": "echo \"env=${{ inputs.environment }} dry=${{ inputs.dry-run }} version=${{ inputs.version }} replicas=${{ inputs.replicas }}\"\n"
        },
        {
          "run": "./deploy.sh ${{ inputs.version }}",
          "env": {
            "TOKEN": "${{ secrets.DEPLOY_TOKEN }}"
          },
          "condition": "!inputs.dry-run"
        }
      ],
      "executor": {
        "kind": "docker",
        "os": "linux",
        "arch": "x64",
        "labels": [
          "ubuntu-latest"
        ]
      },
      "outputs": {
        "summary": true
      },
      "limits": {
        "timeout_seconds": 21600
      },
      "content_hash": "sha256:ec523aa706b796e79892ee041abf650064bd97b40fcaa27333dd8f50fe36b291"
    }
  ],
  "source": {
    "frontend": "actions-yaml",
    "path": ".github/workflows/workflow-dispatch-inputs.yml",
    "compiler_version": "0.1.0",
    "divergences": [
      {
        "code": "job.environment-dynamic",
        "message": "environment \"${{ inputs.environment }}\" cannot be evaluated at plan time; secrets are resolved from the repository scope",
        "location": "jobs.deploy.environment"
      }
    ]
  }
}
